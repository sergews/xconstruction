<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ProLabour | Reliable Construction Labour Services</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Oswald:wght@500;700&display=swap');
        
        body { font-family: 'Inter', sans-serif; }
        h1, h2, h3 { font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: 0.05em; }
        .accent-yellow { background-color: #FBBF24; }
        .text-accent { color: #FBBF24; }
        .bg-construction { background-color: #1A1A1A; }
    </style>
</head>
<body class="bg-gray-50 text-gray-900">

    <nav class="bg-construction text-white sticky top-0 z-50 shadow-lg">
        <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
            <div class="text-2xl font-bold flex items-center tracking-tighter">
                <span class="bg-yellow-500 text-black px-2 mr-1">PRO</span>LABOUR
            </div>
            
            <div class="hidden md:flex space-x-8 font-medium">
                <a href="#home" class="hover:text-yellow-500 transition">Home</a>
                <a href="#services" class="hover:text-yellow-500 transition">Services</a>
                <a href="#about" class="hover:text-yellow-500 transition">About</a>
                <a href="#contact" class="hover:text-yellow-500 transition">Contact</a>
            </div>

            <a href="#contact" class="hidden md:block bg-yellow-500 text-black px-6 py-2 font-bold hover:bg-yellow-400 transition">BOOK NOW</a>

            <button class="md:hidden text-2xl" onclick="toggleMenu()">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <div id="mobileMenu" class="hidden bg-construction border-t border-gray-700 md:hidden p-4 space-y-4">
            <a href="#home" class="block" onclick="toggleMenu()">Home</a>
            <a href="#services" class="block" onclick="toggleMenu()">Services</a>
            <a href="#about" class="block" onclick="toggleMenu()">About</a>
            <a href="#contact" class="block font-bold text-yellow-500" onclick="toggleMenu()">Get a Quote</a>
        </div>
    </nav>

    <header id="home" class="relative h-[80vh] flex items-center bg-gray-900">
        <div class="absolute inset-0 opacity-40">
            <img src="https://images.unsplash.com/photo-1504307651254-35680f3344d7?auto=format&fit=crop&w=1920&q=80" alt="Construction Site" class="w-full h-full object-cover">
        </div>
        <div class="relative max-w-7xl mx-auto px-4 text-white">
            <h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight">Reliable Construction Labour <br><span class="text-yellow-500">When You Need It.</span></h1>
            <p class="text-xl mb-8 max-w-2xl text-gray-200">On-demand general labour for site cleaning, material handling, and rubbish removal. Professional crews ready to keep your project moving.</p>
            <div class="flex flex-col sm:flex-row gap-4">
                <a href="#contact" class="bg-yellow-500 text-black px-8 py-4 text-center font-bold text-lg hover:bg-yellow-400 transition">GET A FREE QUOTE</a>
                <a href="#services" class="border-2 border-white px-8 py-4 text-center font-bold text-lg hover:bg-white hover:text-black transition">OUR SERVICES</a>
            </div>
        </div>
    </header>

    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 grid md:grid-cols-3 gap-8">
            <div class="flex items-start space-x-4">
                <div class="text-yellow-500 text-3xl"><i class="fas fa-hard-hat"></i></div>
                <div>
                    <h3 class="text-xl font-bold mb-2">Vetted Professionals</h3>
                    <p class="text-gray-600">Every worker is screened for reliability and general site safety awareness.</p>
                </div>
            </div>
            <div class="flex items-start space-x-4">
                <div class="text-yellow-500 text-3xl"><i class="fas fa-clock"></i></div>
                <div>
                    <h3 class="text-xl font-bold mb-2">Rapid Response</h3>
                    <p class="text-gray-600">Need boots on the ground tomorrow? We specialize in quick-turnaround staffing.</p>
                </div>
            </div>
            <div class="flex items-start space-x-4">
                <div class="text-yellow-500 text-3xl"><i class="fas fa-shield-alt"></i></div>
                <div>
                    <h3 class="text-xl font-bold mb-2">Safety First</h3>
                    <p class="text-gray-600">Full insurance coverage and strict adherence to on-site safety protocols.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-20 bg-gray-100">
        <div class="max-w-7xl mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold mb-4">Our Services</h2>
                <div class="w-24 h-1 bg-yellow-500 mx-auto"></div>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <div class="bg-white p-8 shadow-md hover:shadow-xl transition group">
                    <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300"><i class="fas fa-broom"></i></div>
                    <h3 class="text-xl font-bold mb-3">Site Cleaning</h3>
                    <p class="text-gray-600">Comprehensive post-construction and daily site cleanup to maintain a safe working environment.</p>
                </div>
                <div class="bg-white p-8 shadow-md hover:shadow-xl transition group">
                    <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300"><i class="fas fa-truck-loading"></i></div>
                    <h3 class="text-xl font-bold mb-3">Rubbish Removal</h3>
                    <p class="text-gray-600">Efficient collection and disposal of site debris, ensuring waste is organized and removed promptly.</p>
                </div>
                <div class="bg-white p-8 shadow-md hover:shadow-xl transition group">
                    <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300"><i class="fas fa-dolly"></i></div>
                    <h3 class="text-xl font-bold mb-3">Material Handling</h3>
                    <p class="text-gray-600">Moving orders to garages or storage. We take the heavy lifting off your skilled tradesmen.</p>
                </div>
                <div class="bg-white p-8 shadow-md hover:shadow-xl transition group">
                    <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300"><i class="fas fa-dumpster"></i></div>
                    <h3 class="text-xl font-bold mb-3">Skip Loading</h3>
                    <p class="text-gray-600">Expertly packing and loading skips to maximize space and efficiency.</p>
                </div>
                <div class="bg-white p-8 shadow-md hover:shadow-xl transition group">
                    <div class="text-4xl mb-4 group-hover:scale-110 transition duration-300"><i class="fas fa-hands-helping"></i></div>
                    <h3 class="text-xl font-bold mb-3">General Labour</h3>
                    <p class="text-gray-600">Extra hands for miscellaneous site tasks, ensuring your project stays on schedule.</p>
                </div>
                <div class="bg-construction text-white p-8 flex flex-col justify-center items-center text-center">
                    <h3 class="text-xl font-bold mb-4">Need Custom Support?</h3>
                    <a href="#contact" class="text-yellow-500 font-bold hover:underline">Contact us today <i class="fas fa-arrow-right ml-2"></i></a>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="py-20 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row items-center gap-12">
            <div class="md:w-1/2">
                <img src="https://images.unsplash.com/photo-1541888946425-d81bb19480c5?auto=format&fit=crop&w=800&q=80" alt="Team" class="rounded shadow-2xl">
            </div>
            <div class="md:w-1/2">
                <h2 class="text-4xl font-bold mb-6">Built on Reliability</h2>
                <p class="text-lg text-gray-700 mb-6">With years of experience in the construction industry, we understand that site efficiency starts with a clean and organized workspace. We don't just provide "bodies"—we provide workers who are punctual, hardworking, and safety-conscious.</p>
                <div class="grid grid-cols-2 gap-6 mb-8">
                    <div>
                        <h4 class="font-bold text-yellow-600 text-2xl">100%</h4>
                        <p class="text-sm uppercase font-bold">Insured Workers</p>
                    </div>
                    <div>
                        <h4 class="font-bold text-yellow-600 text-2xl">24/7</h4>
                        <p class="text-sm uppercase font-bold">Booking Support</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-20 bg-construction text-white">
        <div class="max-w-7xl mx-auto px-4">
            <h2 class="text-3xl font-bold text-center mb-12 uppercase italic">What Site Managers Say</h2>
            <div class="grid md:grid-cols-2 gap-8">
                <div class="bg-zinc-800 p-8 border-l-4 border-yellow-500">
                    <p class="italic mb-4 text-gray-300">"The crew arrived on time and didn't stop until the site was spotless. They're my first call for every new project."</p>
                    <p class="font-bold">- James R., Site Supervisor</p>
                </div>
                <div class="bg-zinc-800 p-8 border-l-4 border-yellow-500">
                    <p class="italic mb-4 text-gray-300">"Incredibly fast material moving. Saved our carpenters three hours of work by having everything ready in the garage."</p>
                    <p class="font-bold">- Sarah L., Project Manager</p>
                </div>
            </div>
        </div>
    </section>

    <section id="contact" class="py-20 bg-gray-100">
        <div class="max-w-4xl mx-auto px-4">
            <div class="bg-white p-8 md:p-12 shadow-2xl rounded-lg">
                <div class="text-center mb-10">
                    <h2 class="text-4xl font-bold mb-2">Get a Quote</h2>
                    <p class="text-gray-600">Tell us about your project and we'll get back to you within 2 hours.</p>
                </div>
                <form id="quoteForm" class="space-y-6">
                    <div class="grid md:grid-cols-2 gap-6">
                        <div>
                            <label class="block font-bold mb-2 text-sm uppercase">Full Name</label>
                            <input type="text" class="w-full border-2 border-gray-200 p-3 outline-none focus:border-yellow-500 transition" placeholder="John Doe" required>
                        </div>
                        <div>
                            <label class="block font-bold mb-2 text-sm uppercase">Phone Number</label>
                            <input type="tel" class="w-full border-2 border-gray-200 p-3 outline-none focus:border-yellow-500 transition" placeholder="0400 000 000" required>
                        </div>
                    </div>
                    <div>
                        <label class="block font-bold mb-2 text-sm uppercase">Email Address</label>
                        <input type="email" class="w-full border-2 border-gray-200 p-3 outline-none focus:border-yellow-500 transition" placeholder="john@company.com" required>
                    </div>
                    <div>
                        <label class="block font-bold mb-2 text-sm uppercase">Job Details (Location, Service, Crew Size)</label>
                        <textarea class="w-full border-2 border-gray-200 p-3 h-32 outline-none focus:border-yellow-500 transition" placeholder="Describe the work required..." required></textarea>
                    </div>
                    <button type="submit" class="w-full bg-yellow-500 text-black font-bold py-4 text-xl hover:bg-yellow-400 transition shadow-lg">REQUEST CREW</button>
                </form>
            </div>
        </div>
    </section>

    <footer class="bg-construction text-gray-400 py-12 border-t border-gray-800">
        <div class="max-w-7xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-8">
            <div>
                <div class="text-2xl font-bold text-white mb-2 tracking-tighter">
                    <span class="bg-yellow-500 text-black px-2 mr-1">PRO</span>LABOUR
                </div>
                <p class="max-w-xs">Professional labor solutions for the modern construction industry.</p>
            </div>
            <div class="flex flex-col items-center md:items-end">
                <div class="flex space-x-6 text-xl mb-4 text-white">
                    <a href="#"><i class="fab fa-facebook-f hover:text-yellow-500"></i></a>
                    <a href="#"><i class="fab fa-instagram hover:text-yellow-500"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in hover:text-yellow-500"></i></a>
                </div>
                <p>Email: contact@prolabour.com</p>
                <p>Phone: 1300-LABOUR-00</p>
            </div>
        </div>
        <div class="text-center mt-12 text-sm">
            &copy; 2026 ProLabour Construction Services. All rights reserved.
        </div>
    </footer>

    <script>
        // Toggle Mobile Menu
        function toggleMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        // Basic Form Submission (Alert)
        document.getElementById('quoteForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Thank you! Your quote request has been sent. We will contact you shortly.');
            this.reset();
        });

        // Smooth Scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({
                    behavior: 'smooth'
                });
            });
        });
    </script>
</body>
</html>
